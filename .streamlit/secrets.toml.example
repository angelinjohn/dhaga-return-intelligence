# Paste into Streamlit Community Cloud > App settings > Secrets,
# or copy locally to .streamlit/secrets.toml (ignored by Git).
# Never put real credentials in this example file.
# Keep values at the top level: Streamlit exposes them as environment variables.

# Optional: leave blank when visitors supply their own OpenAI keys in the UI.
OPENAI_API_KEY = ""

# Model A: primary classification and attribute extraction.
MODEL_A_PROVIDER = "openai"
MODEL_A_NAME = "gpt-4.1-mini"
MODEL_A_TEMPERATURE = "0"

# Model B: re-evaluation of uncertain records; must differ from Model A.
MODEL_B_PROVIDER = "openai"
MODEL_B_NAME = "gpt-4.1"
MODEL_B_TEMPERATURE = "0"

THRESHOLD_A = "0.85"
THRESHOLD_B = "0.80"

# USD per million tokens. Replace with current provider prices.
# Zero means unconfigured: live cost estimates are unavailable, not free.
MODEL_A_INPUT_PRICE_PER_MILLION = "0"
MODEL_A_OUTPUT_PRICE_PER_MILLION = "0"
MODEL_B_INPUT_PRICE_PER_MILLION = "0"
MODEL_B_OUTPUT_PRICE_PER_MILLION = "0"

# Optional technical fallback; an empty name disables it.
# Personal-key mode requires OpenAI for every configured model.
MODEL_FALLBACK_PROVIDER = "openai"
MODEL_FALLBACK_NAME = ""
MODEL_FALLBACK_TEMPERATURE = "0"
MODEL_FALLBACK_INPUT_PRICE_PER_MILLION = "0"
MODEL_FALLBACK_OUTPUT_PRICE_PER_MILLION = "0"

# Optional tracing: enable only after configuring a key and approving data sharing.
# Tracing sends comments, prompts, and model outputs to LangSmith.
LANGSMITH_TRACING = "false"
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "dhaga-return-intelligence"
