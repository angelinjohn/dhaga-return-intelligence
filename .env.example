# Default UI mode is offline. Live mode requires credentials and incurs API charges.
OPENAI_API_KEY=
MODEL_A_PROVIDER=openai
MODEL_A_NAME=gpt-4.1-mini
MODEL_A_TEMPERATURE=0
MODEL_B_PROVIDER=openai
MODEL_B_NAME=gpt-4.1
MODEL_B_TEMPERATURE=0
THRESHOLD_A=0.85
THRESHOLD_B=0.80

# USD per million tokens. Set current provider prices yourself.
# Zero means UNCONFIGURED, not free. Cost is unavailable until all rates are set.
MODEL_A_INPUT_PRICE_PER_MILLION=0
MODEL_A_OUTPUT_PRICE_PER_MILLION=0
MODEL_B_INPUT_PRICE_PER_MILLION=0
MODEL_B_OUTPUT_PRICE_PER_MILLION=0

# Optional alternate endpoint/model for TRANSIENT technical failures only.
# Install the selected provider integration if it differs from OpenAI.
MODEL_FALLBACK_PROVIDER=openai
MODEL_FALLBACK_NAME=
MODEL_FALLBACK_TEMPERATURE=0
MODEL_FALLBACK_INPUT_PRICE_PER_MILLION=0
MODEL_FALLBACK_OUTPUT_PRICE_PER_MILLION=0

# Optional LangSmith: traces include synthetic comments. Off by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dhaga-return-intelligence
